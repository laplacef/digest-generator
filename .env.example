# =============================================================================
# Digest Generator Environment Configuration
# =============================================================================
# Copy this file to .env in the directory you run digest-generator from, then
# fill in the required values. Everything else has a sensible default.
# See digest_generator/shared/settings.py for the full list of values.
# Sampling knobs and CLI flags are documented in docs/usage.md.
#
# Keep each comment on its own line. A comment after an empty value
# (KEY=   # note) is read as the value itself.
# =============================================================================

# -- Required --
# HuggingFace API token. `run` and `label` log in to the Hub before the
# BART-MNLI classifier loads, and fail without a valid token.
HF_TOKEN=

# =============================================================================
# Foundational / shared infrastructure
# =============================================================================

# -- Device --
# Compute device for the classifier: cpu, cuda, or mps.
# DEVICE=cpu

# -- Ollama (shared by the summarizer and every digest stage) --
# The default models are Ollama cloud models. Set OLLAMA_API_KEY to call
# ollama.com directly, or use a local Ollama signed in to an Ollama account.
# To stay fully local, pull local models and set the six *_MODEL values below
# (SUMMARIZER, WRITER, EDITORIAL, FRAMER, WATCHER, CLUSTERER).
# Local Ollama URL, used when OLLAMA_API_KEY is unset.
# OLLAMA_HOST=http://localhost:11434
# Setting a key sends every stage to cloud Ollama (auto-detected).
# OLLAMA_API_KEY=
# Global cap on in-flight Ollama calls. Raise it for a local GPU.
# OLLAMA_CONCURRENCY=3
# Read timeout per call, in seconds.
# OLLAMA_READ_TIMEOUT_S=300

# =============================================================================
# Pipeline stages (in execution order)
# =============================================================================

# -- Feeds source (RSS feed discovery) --
# Feeds are defined in a feeds.yaml (see feeds.example.yaml). With neither
# FEEDS_FILE nor DIGEST_CONFIG set, the loader searches
# ./digest-generator/feeds.yaml, then ~/.config/digest-generator/feeds.yaml.
# Explicit path to a feeds.yaml file (the --feeds flag overrides it).
# FEEDS_FILE=
# Config directory holding feeds.yaml and an optional prompts/ directory.
# The --config flag selects the feeds file only; prompt overrides follow
# this variable.
# DIGEST_CONFIG=
# Directory of prompt-template overrides (<name>.md), checked first.
# PROMPTS_DIR=

# -- Fetcher --
# HTTP request timeout, in seconds.
# FETCH_TIMEOUT=10
# Delay between article fetches, in seconds.
# FETCH_RATE_LIMIT=0.4
# Max concurrent feed fetches.
# FETCH_CONCURRENCY=10
# Article quality check: minimum characters, and the maximum boilerplate
# fraction before an article is rejected.
# MIN_CONTENT_LENGTH=200
# MAX_BOILERPLATE_RATIO=0.05

# -- Summarizer (per-article fact extraction) --
# One LLM call per article, producing a fact-dense 2-4 sentence summary.
# SUMMARIZER_MODEL=gemma4:31b-cloud
# SUMMARIZER_TEMPERATURE=0.2
# top_p, repetition_penalty, and seed are unset by default, so Ollama's own
# defaults apply. The values below are examples. Leave a line commented out
# to keep the Ollama default, since an empty value does not parse.
# SUMMARIZER_TOP_P=0.9
# SUMMARIZER_REPETITION_PENALTY=1.1
# SUMMARIZER_SEED=42
# Max concurrent per-article LLM calls.
# SUMMARIZER_CONCURRENCY=8
# Max characters of raw article text passed to the digest writer.
# CONTENT_HEAD_MAX_CHARS=2000

# -- Topic classifier (BART-MNLI zero-shot) --
# TOPIC_MODEL=facebook/bart-large-mnli
# TOPIC_REVISION=d7645e127eaf1aefc7862fd59a17a5aa8558b8ce
# Minimum probability to accept a label.
# TOPIC_THRESHOLD=0.5
# Maximum input length, in tokens.
# TOPIC_MAX_LENGTH=512
# Max premise-hypothesis pairs per forward pass. Raise it on a GPU; lower it
# if CPU memory is tight.
# TOPIC_BATCH_SIZE=128

# -- Digest stage models --
# The clusterer groups articles by story, the writer drafts each section, the
# editor cleans up the prose, the framer writes the title and intro, and the
# watcher writes the cross-section watch list. The framer, watcher, and
# clusterer default to gpt-oss:120b-cloud. Setting one of them to an empty
# value falls back to WRITER_MODEL.
# WRITER_MODEL=gemma4:31b-cloud
# EDITORIAL_MODEL=gpt-oss:120b-cloud
# FRAMER_MODEL=gpt-oss:120b-cloud
# WATCHER_MODEL=gpt-oss:120b-cloud
# CLUSTERER_MODEL=gpt-oss:120b-cloud

# -- Digest stage temperatures --
# WRITER_TEMPERATURE=0.4
# EDITORIAL_TEMPERATURE=0.4
# FRAMER_TEMPERATURE=0.4
# WATCHER_TEMPERATURE=0.4
# CLUSTERER_TEMPERATURE=0.4

# -- Digest stage sampling knobs --
# Each stage exposes top_p (nucleus cutoff), repetition_penalty, and seed (for
# reproducible output). All are unset by default, so Ollama's own defaults
# apply. The values below are examples. Leave a line commented out to keep the
# Ollama default, since an empty value does not parse. The `digest` subcommand
# has matching CLI flags (--writer-seed N, and so on) plus a global --seed N;
# the clusterer is configured here only.
# WRITER_TOP_P=0.9
# WRITER_REPETITION_PENALTY=1.1
# WRITER_SEED=42
# EDITORIAL_TOP_P=0.9
# EDITORIAL_REPETITION_PENALTY=1.1
# EDITORIAL_SEED=42
# FRAMER_TOP_P=0.9
# FRAMER_REPETITION_PENALTY=1.1
# FRAMER_SEED=42
# WATCHER_TOP_P=0.9
# WATCHER_REPETITION_PENALTY=1.1
# WATCHER_SEED=42
# CLUSTERER_TOP_P=0.9
# CLUSTERER_REPETITION_PENALTY=1.1
# CLUSTERER_SEED=42

# -- Writer extras --
# Max articles per writer batch.
# WRITER_SECTION_BATCH_SIZE=30

# -- Audio (opt-in TTS narration via Piper + ffmpeg) --
# Off by default. Enable per invocation with --audio on `digest-generator run`
# or `digest-generator digest`, or with the standalone `digest-generator audio`.
# Piper voice id from rhasspy/piper-voices.
# AUDIO_VOICE_MODEL=en_US-amy-medium
# Pinned voice-repo revision (the v1.0.0 tag).
# AUDIO_VOICE_REVISION=375a0fe641dea077c2a47b4e9a056d6da521eed3
# Opus encode bitrate in kbps (mono spoken word).
# AUDIO_BITRATE_KBPS=24
# Piper sample rate (voice-dependent).
# AUDIO_SAMPLE_RATE=22050
# Cache for downloaded Piper voice files. Use an absolute path: a leading `~`
# is not expanded, but ${HOME} is.
# AUDIO_VOICE_CACHE=${HOME}/.cache/digest_generator/piper-voices
# Override the ffmpeg binary path.
# AUDIO_FFMPEG_PATH=ffmpeg
# Pause length between sentences, in seconds.
# AUDIO_SENTENCE_SILENCE_S=0.4

# =============================================================================
# Pipeline-level
# =============================================================================

# How many days back to fetch articles.
# DAYS_BACK=7
# Parent directory for run directories; each run creates output/<run_id>/.
# OUTPUT_DIR=output

# =============================================================================
# Logging
# =============================================================================

# Console and file log levels. The file level covers logs/digest_generator.log
# and each run's run.log.
# LOG_LEVEL_CONSOLE=INFO
# LOG_LEVEL_FILE=DEBUG
# Global log file directory.
# LOG_DIR=logs
# Size-based rotation and the number of rotated files kept for the global log.
# LOG_ROTATION=20 MB
# LOG_RETENTION=5
